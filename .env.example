# ─── SERVER ───────────────────────────────────────────
PORT=8080
ENV=development                        # development | production
# DEV_BYPASS_USER_ID=4946c101-f0e4-4c6d-a094-012a6ff7775a  # Dev only: unlimited quotes for this user

# ─── SUPABASE ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT ──────────────────────────────────────────────
# No longer needed: auth uses Supabase JWKS (ES256) — keys fetched from SUPABASE_URL/auth/v1/.well-known/jwks.json
# JWT_SECRET=legacy-hs256-only-if-using-old-supabase-project

# ─── EMAIL (Resend) ───────────────────────────────────
# 1. Sign up at resend.com (free: 3,000 emails/month)
# 2. Go to resend.com/api-keys → Create API Key → copy the key
# 3. For testing: use onboarding@resend.dev (no domain needed)
# 4. For production: add & verify your domain at resend.com/domains
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=QuoteFlow

# ─── WHATSAPP (Twilio) ────────────────────────────────
# Sign up at twilio.com — free trial available
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── APP ──────────────────────────────────────────────
APP_URL=http://localhost:8080
FRONTEND_URL=https://quote-flow-phi.vercel.app
QUOTE_LINK_BASE_URL=https://quote-flow-phi.vercel.app/q

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://quote-flow-phi.vercel.app,http://localhost:5173,http://localhost:3000
