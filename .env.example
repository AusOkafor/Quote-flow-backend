# ─── SERVER ───────────────────────────────────────────
PORT=8080
ENV=development                        # development | production
# DEV_BYPASS_USER_ID=4946c101-f0e4-4c6d-a094-012a6ff7775a  # Dev only: unlimited quotes for this user

# ─── SUPABASE ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ─── JWT ──────────────────────────────────────────────
# No longer needed: auth uses Supabase JWKS (ES256) — keys fetched from SUPABASE_URL/auth/v1/.well-known/jwks.json
# JWT_SECRET=legacy-hs256-only-if-using-old-supabase-project

# ─── EMAIL (Resend) ───────────────────────────────────
# 1. Sign up at resend.com (free: 3,000 emails/month)
# 2. Go to resend.com/api-keys → Create API Key → copy the key
# 3. For testing: use onboarding@resend.dev (no domain needed)
# 4. For production: add & verify your domain at resend.com/domains
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=QuoteFlow

# ─── WHATSAPP (Twilio) ────────────────────────────────
# Sign up at twilio.com — free trial available
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── SECURITY ─────────────────────────────────────────
# Encryption key for payment credentials at rest. Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── APP ──────────────────────────────────────────────
APP_URL=http://localhost:8080
FRONTEND_URL=https://quote-flow-phi.vercel.app
QUOTE_LINK_BASE_URL=https://quote-flow-phi.vercel.app/q

# ─── STRIPE ───────────────────────────────────────────
# 1. Create Products & Prices in Stripe Dashboard (Products → Add product)
# 2. Pro Monthly $15, Pro Annual $144, Business Monthly $39, Business Annual $384
# 3. Webhooks: Developers → Webhooks → Add endpoint → /billing/webhook
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_ANNUAL=price_xxx

# ─── PAYPAL ────────────────────────────────────────
# PayPal Commerce Platform (for client payments)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=   # PayPal Dashboard → Webhooks → your webhook → ID
# PAYPAL_ENVIRONMENT=sandbox

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://quote-flow-phi.vercel.app,http://localhost:5173,http://localhost:3000
